local function randId()
    local c = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
    local n = math.random(6, 12)
    local t = {}
    for i=1,n do local k = math.random(1,#c); t[i] = c:sub(k,k) end
    return table.concat(t)
end

local function makeDeadStmt()
    local ty = math.random(1, 5)
    if ty == 1 then
        return {tag="local", name=randId(), init={tag="number", value=math.random(1,999999)}}
    elseif ty == 2 then
        return {tag="local", name=randId(), init={tag="binop", op="+",
            left={tag="number", value=math.random(1,9999)},
            right={tag="number", value=math.random(1,9999)}}}
    elseif ty == 3 then
        return {tag="assign", target={tag="name", name=randId()},
            value={tag="number", value=math.random(1,9999)}}
    elseif ty == 4 then
        return {tag="callstmt", call={tag="call", func={tag="name", name="print"},
            args={{tag="string", value=randId()}, {tag="number", value=math.random(1,9999)}}}}
    else
        return {tag="local", name=randId(), init={tag="string", value=randId()}}
    end
end

local function makeDeadBlock(depth)
    local n = math.random(CFG.DEAD_MIN, CFG.DEAD_MAX)
    local body = {}
    for i=1,n do body[#body+1] = makeDeadStmt() end
    local block = {tag="if", branches={{cond={tag="bool", value=false}, body=body}}}
    if depth > 1 then table.insert(body, makeDeadBlock(depth - 1)) end
    return block
end

local function injectDead(stmts, depth)
    local out = {}
    for i=1,#stmts do
        out[#out+1] = stmts[i]
        if math.random() < CFG.DEAD_RATE then
            out[#out+1] = makeDeadBlock(depth)
        end
    end
    for i=#stmts,1,-1 do stmts[i] = nil end
    for i=1,#out do stmts[i] = out[i] end
    for _, s in ipairs(stmts) do
        if s.branches then
            for _, br in ipairs(s.branches) do injectDead(br.body, depth) end
        end
        if s.elseBody then injectDead(s.elseBody, depth) end
        if s.body and s.body[1] and s.body[1].tag then injectDead(s.body, depth) end
    end
end

