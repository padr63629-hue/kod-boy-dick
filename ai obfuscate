local function obfuscate(src)
    local toks = lex(src)
    local parser = P.new(toks)
    local ast = parser:parseBlock({})
    injectDead(ast, CFG.DEAD_DEPTH)
    local c = C.new()
    c:pushScope()
    c:compileBlock(ast)
    c:emit(O.HALT)
    c:popScope()

    local key = randKey()
    local dbgStr = CFG.DEBUG_ANTI and "true" or "false"
    local antiHead = ANTI_HEAD:gsub("__DEBUG_FLAG__", dbgStr)

    local header =
        'local __k=' .. string.format("%q", key) .. '\n' ..
        'local __d=function(h)\n' ..
        'local t={}\n' ..
        'for i=1,#h,2 do\n' ..
        'local b=tonumber(h:sub(i,i+1),16)\n' ..
        'local k=string.byte(__k,((i-1)//2%#__k)+1)\n' ..
        't[#t+1]=string.char(bit32.bxor(b,k))\n' ..
        'end\n' ..
        'return table.concat(t)\n' ..
        'end\n' ..
        'local __c=' .. serializeConsts(c.consts, key) .. '\n' ..
        'local __b=' .. serializeCode(c.code) .. '\n'

    return header .. antiHead .. ANTI_BODY .. "\n" .. VM_RUNTIME
end

