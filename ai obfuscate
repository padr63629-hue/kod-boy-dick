--============================================================
-- 1. Lexer
--============================================================
local KEYWORDS = {
    and=true,break=true,do=true,else=true,elseif=true,end=true,false=true,
    for=true,function=true,if=true,in=true,local=true,nil=true,not=true,
    or=true,repeat=true,return=true,then=true,true=true,until=true,while=true,
}
local function lex(src)
    local t, i, n = {}, 1, #src
    local function push(ty, v) t[#t+1] = {ty=ty, v=v} end
    while i <= n do
        local c = src:sub(i,i)
        if c:match("%s") then i = i + 1
        elseif c == "-" and src:sub(i+1,i+1) == "-" then
            local eqs = src:sub(i+1):match("^%-%[(=*)%[")
            if eqs then
                local close = "]"..eqs.."]"
                local e = src:find(close, i+1, true)
                i = e and (e + #close) or (n+1)
            else
                local e = src:find("\n", i, true); i = e or (n+1)
            end
        elseif c:match("%d") or (c == "." and src:sub(i+1,i+1):match("%d")) then
            local s = i
            if src:sub(i,i+1) == "0x" or src:sub(i,i+1) == "0X" then
                i = i + 2
                while i <= n and src:sub(i,i):match("[%da-fA-F]") do i = i + 1 end
            else
                while i <= n and src:sub(i,i):match("%d") do i = i + 1 end
                if src:sub(i,i) == "." and src:sub(i+1,i+1) ~= "." and src:sub(i+1,i+1):match("%d") then
                    i = i + 1
                    while i <= n and src:sub(i,i):match("%d") do i = i + 1 end
                end
                if src:sub(i,i):match("[eE]") then
                    i = i + 1
                    if src:sub(i,i)=="+" or src:sub(i,i)=="-" then i = i + 1 end
                    while i <= n and src:sub(i,i):match("%d") do i = i + 1 end
                end
            end
            push("number", tonumber(src:sub(s,i-1)))
        elseif c == '"' or c == "'" then
            local q = c; i = i + 1
            local buf = {}
            while i <= n do
                local d = src:sub(i,i)
                if d == "\\" then
                    local nc = src:sub(i+1,i+1)
                    local map = {n="\n",t="\t",r="\r",["\\"]="\\",['"']='"',["'"]="'"}
                    buf[#buf+1] = map[nc] or nc
                    i = i + 2
                elseif d == q then i = i + 1; break
                else buf[#buf+1] = d; i = i + 1 end
            end
            push("string", table.concat(buf))
        elseif c == "[" then
            local eqs = src:sub(i):match("^%[(=*)%[")
            if eqs then
                local close = "]"..eqs.."]"
                local s = i + #eqs + 2
                local e = src:find(close, s, true)
                if e then push("string", src:sub(s,e-1)); i = e + #close
                else error("长字符串未闭合") end
            else push("punct", "["); i = i + 1 end
        elseif c:match("[%a_]") then
            local s = i
            while i <= n and src:sub(i,i):match("[%w_]") do i = i + 1 end
            local w = src:sub(s,i-1)
            if KEYWORDS[w] then push("keyword", w) else push("name", w) end
        else
            local t3 = src:sub(i,i+2); local t2 = src:sub(i,i+1)
            if t3 == "..." then push("punct","..."); i = i + 3
            elseif t2=="==" or t2=="~=" or t2=="<=" or t2==">=" or t2==".." then
                push("punct", t2); i = i + 2
            else push("punct", c); i = i + 1 end
        end
    end
    push("eof")
    return t
end

--============================================================
-- 2. Parser
--============================================================
local BINOP = {
    ["or"]={p=1}, ["and"]={p=2},
    ["<"]={p=3}, [">"]={p=3}, ["<="]={p=3}, [">="]={p=3},
    ["=="]={p=3}, ["~="]={p=3},
    [".."]={p=4,r=true},
    ["+"]={p=5}, ["-"]={p=5},
    ["*"]={p=6}, ["/"]={p=6}, ["%"]={p=6},
    ["^"]={p=8,r=true},
}
local UNOP = { ["not"]=7, ["-"]=7, ["#"]=7 }

local P = {}
P.__index = P
function P.new(toks) return setmetatable({t=toks,i=1}, P) end
function P:peek() return self.t[self.i] end
function P:next() local t=self.t[self.i]; self.i=self.i+1; return t end
function P:ck(ty,v) local t=self:peek(); return t.ty==ty and (v==nil or t.v==v) end
function P:ac(ty,v) if self:ck(ty,v) then return self:next() end end
function P:ex(ty,v) if not self:ck(ty,v) then error("期望 "..tostring(v or ty)) end; return self:next() end

function P:parseBlock(stops)
    local stmts = {}
    while true do
        local t = self:peek()
        if t.ty == "eof" then break end
        if t.ty == "keyword" and stops[t.v] then break end
        if t.ty == "punct" and t.v == ";" then self:next()
        else stmts[#stmts+1] = self:parseStatement() end
    end
    return stmts
end

function P:parseStatement()
    local t = self:peek()
    if t.ty == "keyword" then
        if t.v == "local" then
            self:next()
            local name = self:ex("name").v
            local init
            if self:ac("punct","=") then init = self:parseExpr() end
            return {tag="local", name=name, init=init}
        elseif t.v == "if" then return self:parseIf()
        elseif t.v == "while" then return self:parseWhile()
        elseif t.v == "for" then return self:parseFor()
        elseif t.v == "return" then
            self:next()
            local e = self:parseExpr()
            return {tag="return", value=e}
        elseif t.v == "do" then
            self:next()
            local b = self:parseBlock({["end"]=true})
            self:ex("keyword","end")
            return {tag="do", body=b}
        end
    elseif t.ty == "name" then
        self:next()
        local e = self:applySuffix({tag="name", name=t.v})
        if self:ac("punct","=") then
            local v = self:parseExpr()
            return {tag="assign", target=e, value=v}
        end
        return {tag="callstmt", call=e}
    end
    error("无法解析语句: "..tostring(t.v))
end

function P:parseIf()
    self:ex("keyword","if")
    local cond = self:parseExpr()
    self:ex("keyword","then")
    local branches = {{cond=cond, body=self:parseBlock({["else"]=true,["elseif"]=true,["end"]=true})}}
    while self:ac("keyword","elseif") do
        local c = self:parseExpr()
        self:ex("keyword","then")
        local b = self:parseBlock({["else"]=true,["elseif"]=true,["end"]=true})
        branches[#branches+1] = {cond=c, body=b}
    end
    local elseBody
    if self:ac("keyword","else") then
        elseBody = self:parseBlock({["end"]=true})
    end
    self:ex("keyword","end")
    return {tag="if", branches=branches, elseBody=elseBody}
end

function P:parseWhile()
    self:ex("keyword","while")
    local cond = self:parseExpr()
    self:ex("keyword","do")
    local body = self:parseBlock({["end"]=true})
    self:ex("keyword","end")
    return {tag="while", cond=cond, body=body}
end

function P:parseFor()
    self:ex("keyword","for")
    local name = self:ex("name").v
    self:ex("punct","=")
    local f = self:parseExpr()
    self:ex("punct",",")
    local t = self:parseExpr()
    local s
    if self:ac("punct",",") then s = self:parseExpr() end
    self:ex("keyword","do")
    local body = self:parseBlock({["end"]=true})
    self:ex("keyword","end")
    return {tag="for", var=name, from=f, to=t, step=s, body=body}
end

function P:parseExpr(mp)
    mp = mp or 1
    local left = self:parseUnary()
    while true do
        local t = self:peek()
        local k = (t.ty=="punct" or t.ty=="keyword") and t.v
        local op = k and BINOP[k]
        if not op or op.p < mp then break end
        self:next()
        local nm = op.r and op.p or (op.p + 1)
        local right = self:parseExpr(nm)
        left = {tag="binop", op=k, left=left, right=right}
    end
    return left
end

function P:parseUnary()
    local t = self:peek()
    local k = (t.ty=="punct" or t.ty=="keyword") and t.v
    if k and UNOP[k] then
        self:next()
        local operand = self:parseExpr(UNOP[k])
        return {tag="unop", op=k, operand=operand}
    end
    return self:parseSuffix()
end

function P:parsePrimary()
    local t = self:peek()
    if t.ty == "number" then self:next(); return {tag="number", value=t.v}
    elseif t.ty == "string" then self:next(); return {tag="string", value=t.v}
    elseif t.ty == "keyword" and t.v == "nil" then self:next(); return {tag="nil"}
    elseif t.ty == "keyword" and t.v == "true" then self:next(); return {tag="bool", value=true}
    elseif t.ty == "keyword" and t.v == "false" then self:next(); return {tag="bool", value=false}
    elseif t.ty == "name" then self:next(); return {tag="name", name=t.v}
    elseif t.ty == "punct" and t.v == "(" then
        self:next(); local e = self:parseExpr(); self:ex("punct",")"); return e
    end
    error("无法解析表达式: "..tostring(t.v))
end

function P:parseSuffix() return self:applySuffix(self:parsePrimary()) end

function P:applySuffix(e)
    while true do
        local t = self:peek()
        if t.ty == "punct" and t.v == "(" then
            self:next()
            local args = {}
            if not self:ck("punct",")") then
                args[1] = self:parseExpr()
                while self:ac("punct",",") do args[#args+1] = self:parseExpr() end
            end
            self:ex("punct",")")
            e = {tag="call", func=e, args=args}
        elseif t.ty == "punct" and t.v == "[" then
            self:next()
            local k = self:parseExpr()
            self:ex("punct","]")
            e = {tag="index", obj=e, key=k}
        elseif t.ty == "punct" and t.v == "." then
            self:next()
            local nm = self:ex("name").v
            e = {tag="index", obj=e, key={tag="string", value=nm}}
        else break end
    end
    return e
end

--============================================================
-- 3. Opcodes
--============================================================
local O = {
    HALT=0, PUSH_NUM=1, PUSH_STR=2, PUSH_NIL=3, PUSH_TRUE=4, PUSH_FALSE=5,
    GET_G=6, SET_G=7, GET_L=8, SET_L=9,
    ADD=10, SUB=11, MUL=12, DIV=13, MOD=14, POW=15, CONCAT=16,
    EQ=17, NEQ=18, LT=19, LE=20, GT=21, GE=22,
    NOT=23, NEG=24, LEN=25,
    CALL=26, RET=27, POP=28,
    JMP=29, JF=30, JT=31, JFK=32, JTK=33,
    GETI=34, SETI=35, NEWT=36,
}

--============================================================
-- 4. Compiler
--============================================================
local C = {}
C.__index = C
function C.new() return setmetatable({code={}, consts={}, cmap={}, scopes={}, slotMax=0}, C) end
function C:emit(op,a,b,c) self.code[#self.code+1] = {op,a,b,c}; return #self.code end
function C:addConst(v)
    if self.cmap[v] then return self.cmap[v] end
    self.consts[#self.consts+1] = v
    self.cmap[v] = #self.consts
    return #self.consts
end
function C:pushScope() self.scopes[#self.scopes+1] = {} end
function C:popScope() self.scopes[#self.scopes] = nil end
function C:decl(name)
    self.slotMax = self.slotMax + 1
    self.scopes[#self.scopes][name] = self.slotMax
    return self.slotMax
end
function C:res(name)
    for i = #self.scopes, 1, -1 do
        local s = self.scopes[i]
        if s[name] then return s[name] end
    end
end

function C:compileExpr(e)
    local tg = e.tag
    if tg == "number" then self:emit(O.PUSH_NUM, e.value)
    elseif tg == "string" then self:emit(O.PUSH_STR, self:addConst(e.value))
    elseif tg == "nil" then self:emit(O.PUSH_NIL)
    elseif tg == "bool" then self:emit(e.value and O.PUSH_TRUE or O.PUSH_FALSE)
    elseif tg == "name" then
        local s = self:res(e.name)
        if s then self:emit(O.GET_L, s)
        else self:emit(O.GET_G, self:addConst(e.name)) end
    elseif tg == "binop" then
        local op = e.op
        if op == "and" then
            self:compileExpr(e.left)
            local j = self:emit(O.JFK, 0)
            self:compileExpr(e.right)
            self.code[j][2] = #self.code + 1
            return
        elseif op == "or" then
            self:compileExpr(e.left)
            local j = self:emit(O.JTK, 0)
            self:compileExpr(e.right)
            self.code[j][2] = #self.code + 1
            return
        end
        self:compileExpr(e.left)
        self:compileExpr(e.right)
        local map = {
            ["+"]=O.ADD, ["-"]=O.SUB, ["*"]=O.MUL, ["/"]=O.DIV,
            ["%"]=O.MOD, ["^"]=O.POW, [".."]=O.CONCAT,
            ["=="]=O.EQ, ["~="]=O.NEQ,
            ["<"]=O.LT, [">"]=O.GT, ["<="]=O.LE, [">="]=O.GE,
        }
        if map[op] then self:emit(map[op]) else error("不支持: "..op) end
    elseif tg == "unop" then
        self:compileExpr(e.operand)
        if e.op == "not" then self:emit(O.NOT)
        elseif e.op == "-" then self:emit(O.NEG)
        elseif e.op == "#" then self:emit(O.LEN) end
    elseif tg == "call" then
        self:compileExpr(e.func)
        for i=1,#e.args do self:compileExpr(e.args[i]) end
        self:emit(O.CALL, #e.args)
    elseif tg == "index" then
        self:compileExpr(e.obj)
        self:compileExpr(e.key)
        self:emit(O.GETI)
    end
end

function C:compileStmt(s)
    local tg = s.tag
    if tg == "local" then
        if s.init then self:compileExpr(s.init) else self:emit(O.PUSH_NIL) end
        local slot = self:decl(s.name)
        self:emit(O.SET_L, slot)
        self:emit(O.POP)
    elseif tg == "assign" then
        local t = s.target
        if t.tag == "name" then
            self:compileExpr(s.value)
            local slot = self:res(t.name)
            if slot then self:emit(O.SET_L, slot)
            else self:emit(O.SET_G, self:addConst(t.name)) end
            self:emit(O.POP)
        elseif t.tag == "index" then
            self:compileExpr(t.obj)
            self:compileExpr(t.key)
            self:compileExpr(s.value)
            self:emit(O.SETI)
            self:emit(O.POP)
        end
    elseif tg == "callstmt" then
        self:compileExpr(s.call)
        self:emit(O.POP)
    elseif tg == "if" then self:compileIf(s)
    elseif tg == "while" then self:compileWhile(s)
    elseif tg == "for" then self:compileFor(s)
    elseif tg == "return" then
        if s.value then self:compileExpr(s.value) else self:emit(O.PUSH_NIL) end
        self:emit(O.RET)
    elseif tg == "do" then
        self:pushScope(); self:compileBlock(s.body); self:popScope()
    end
end

function C:compileBlock(ss)
    for i=1,#ss do self:compileStmt(ss[i]) end
end

function C:compileIf(s)
    local ends = {}
    for i, br in ipairs(s.branches) do
        self:compileExpr(br.cond)
        local jf = self:emit(O.JF, 0)
        self:pushScope(); self:compileBlock(br.body); self:popScope()
        if i < #s.branches or s.elseBody then
            ends[#ends+1] = self:emit(O.JMP, 0)
        end
        self.code[jf][2] = #self.code + 1
    end
    if s.elseBody then
        self:pushScope(); self:compileBlock(s.elseBody); self:popScope()
    end
    local e = #self.code + 1
    for i=1,#ends do self.code[ends[i]][2] = e end
end

function C:compileWhile(s)
    local start = #self.code + 1
    self:compileExpr(s.cond)
    local jf = self:emit(O.JF, 0)
    self:pushScope(); self:compileBlock(s.body); self:popScope()
    self:emit(O.JMP, start)
    self.code[jf][2] = #self.code + 1
end

function C:compileFor(s)
    local sv = self:decl(s.var)
    local sl = self:decl("__lim_"..s.var)
    local st = self:decl("__stp_"..s.var)
    self:compileExpr(s.from); self:emit(O.SET_L, sv); self:emit(O.POP)
    self:compileExpr(s.to);   self:emit(O.SET_L, sl); self:emit(O.POP)
    if s.step then self:compileExpr(s.step) else self:emit(O.PUSH_NUM, 1) end
    self:emit(O.SET_L, st); self:emit(O.POP)
    local start = #self.code + 1
    self:emit(O.GET_L, sv); self:emit(O.GET_L, sl); self:emit(O.GT)
    local jf = self:emit(O.JT, 0)
    self:pushScope(); self:compileBlock(s.body); self:popScope()
    self:emit(O.GET_L, sv); self:emit(O.GET_L, st); self:emit(O.ADD)
    self:emit(O.SET_L, sv); self:emit(O.POP)
    self:emit(O.JMP, start)
    self.code[jf][2] = #self.code + 1
end

