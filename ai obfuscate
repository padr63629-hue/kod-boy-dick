-- 6. 序列化
--============================================================
local function xorHex(str, key)
    local out = {}
    for i=1,#str do
        local b = string.byte(str, i)
        local k = string.byte(key, ((i-1) % #key) + 1)
        out[i] = string.format("%02x", bit32.bxor(b, k))
    end
    return table.concat(out)
end

local function randKey()
    local t = {}
    for i=1,16 do t[i] = string.char(math.random(33, 126)) end
    return table.concat(t)
end

local function serializeConsts(consts, key)
    local parts = {}
    for i=1,#consts do
        local v = consts[i]
        if type(v) == "string" then parts[i] = '"'..xorHex(v, key)..'"'
        elseif v == nil then parts[i] = "nil"
        elseif type(v) == "boolean" then parts[i] = tostring(v)
        else parts[i] = tostring(v) end
    end
    return "{"..table.concat(parts,",").."}"
end

local function serializeCode(code)
    local parts = {}
    for i=1,#code do
        local ins = code[i]
        local p = {tostring(ins[1])}
        for j=2,4 do if ins[j] ~= nil then p[#p+1] = tostring(ins[j]) end end
        parts[i] = "{"..table.concat(p,",").."}"
    end
    return "{"..table.concat(parts,",").."}"
end

